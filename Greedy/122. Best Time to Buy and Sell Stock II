greedy will be a local optimal solution , 90% will be sorting.
// Approach 1
class Solution {
    public int maxProfit(int[] prices) {
        int n = prices.length;
        if(n<2){
            return 0;
        }
        int[] arr = new int[n-1];
        arr[0] = prices[1]-prices[0];
        for(int i=2;i<n;i++){
            int d = prices[i]-prices[i-1];
            if(d>0 && arr[i-2]>0){
                arr[i-1] = arr[i-2]+d;
            }
            else if(d>0 || arr[i-2]>0){
                arr[i-1] = Math.max(d,arr[i-2]);
            }
            else{
                arr[i-1] = Math.max(d,arr[i-2]);
            }

        }
        if(arr[n-2]<0){
            return 0;
        }
        return arr[n-2];

    }

}
// Approach 2
class Solution {
    public int maxProfit(int[] prices) {
        int d = 0;
        for(int i=0;i<prices.length-1;i++){
            int a = prices[i+1]-prices[i];
            if(a>0){
                d = d+a;
            }
        }
        return d;
    }
}
