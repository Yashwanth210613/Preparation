//Approach 1
class Solution {
    public int candy(int[] ratings) {
        int n = ratings.length;
        int[]a = new int[n];
        int[] b = new int[n];
        Arrays.fill(a,1);
        Arrays.fill(b,1);
        for(int i=1;i<n;i++){
            if(ratings[i]>ratings[i-1]){
                a[i] = 1+a[i-1];
            }
        }
        for(int i=n-2;i>=0;i--){
            if(ratings[i]>ratings[i+1]){
                b[i] = 1+b[i+1];
            }
        }
        
        int s = 0;
        for(int i=0;i<n;i++){
            s += Math.max(a[i],b[i]);
        }
        return s;
    }
}
//Approach 2
class Solution {
    public int candy(int[] ratings) {
        int n = ratings.length;
        int[]a = new int[n];
        Arrays.fill(a,1);
        for(int i=1;i<n;i++){
            if(ratings[i]>ratings[i-1]){
                a[i] = 1+a[i-1];
            }
        }
        for(int i=n-2;i>=0;i--){
            if(ratings[i]>ratings[i+1]){
                a[i] = Math.max(1+a[i+1],a[i]);
            }
        }
        
        
        int s = 0;
        for(int i=0;i<n;i++){
            s += a[i];
        }
        return s;
    }
}
