class Solution {
    public int twoCitySchedCost(int[][] costs) {
       Arrays.sort(costs,(a,b)->Integer.compare(a[0]-a[1],b[0]-b[1]));
       int s1 = 0;
       int s2=0;
       for(int i=0;i<costs.length/2;i++){
        s1+=costs[i][0];
       }
       for(int i=costs.length/2;i<costs.length;i++){
        s2+=costs[i][1];
       }
       return s1+s2;
    }
}
