class Solution {
    public int findContentChildren(int[] g, int[] s) {
        int n1 = g.length;
        int n2 = s.length;
        Arrays.sort(g);
        Arrays.sort(s);
        int sum=0;
        int i=0;
        int j=0;
        while(i<n1 && j<n2){
            if(g[i] <= s[j]){
                sum+=1;
                i++;
                j++;
            }else{
                j++;
            }
        }
        return i;
    }
}
