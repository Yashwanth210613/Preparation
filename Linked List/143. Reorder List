class Solution {
    public void reorderList(ListNode head) {
        if(head == null || head.next == null){
            return;
        }
        ListNode slow = head;
        ListNode fast = head;
        while(fast.next != null && fast.next.next != null){
            slow = slow.next;
            fast = fast.next.next;
        }
        ListNode mid = slow;
        ListNode cur = slow.next;
        while(cur.next != null){
            ListNode temp = cur.next;
            cur.next = temp.next;
            temp.next = mid.next;
            mid.next = temp;
        }
        slow = head;
        fast = mid.next;
        while(slow != mid){
            mid.next = fast.next;
            fast.next = slow.next;
            slow.next = fast;
            slow = fast.next;
            fast = mid.next;
        }
    }
}
