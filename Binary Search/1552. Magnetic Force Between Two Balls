class Solution {
    public int maxDistance(int[] position, int m) {
        Arrays.sort(position);
        int low = 1;
        int high = position[position.length - 1] - position[0];
        while(low <= high){
            int mid = (low+high)/2;
            if(canplace(position,mid,m)){
                low = mid+1;
            }
            else{
                high = mid-1;
            }
        }
        return high;
    }
    static boolean canplace(int[] position,int val,int m){
        int cur = 1;
        int last = position[0];
        for(int i=1;i<position.length;i++){
            if(position[i] - last >= val){
                cur++;
                last = position[i];
            }
            if(cur >= m){
                return true;
            }
        }
        return false;
    }
}
