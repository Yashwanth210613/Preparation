class Solution {
    int count = 0;
    int res = 0;
    public int kthSmallest(TreeNode root, int k) {
        Inorder(root,k);
        return res;
    }
    public void Inorder(TreeNode root,int k){
        if(root == null){
            return;
        }
        Inorder(root.left,k);
        count++;
        if(count == k){
            res = root.val;
            return;
        }
        Inorder(root.right,k);
    }
}
