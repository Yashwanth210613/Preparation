class Solution {
    public int lengthOfLIS(int[] nums) {
        int n = nums.length;
        int[] dp = new int[n];
        int max = 0;
        Arrays.fill(dp,1);
        for(int row=0;row<n;row++){
            int val = nums[row];
            for(int col=0;col<row;col++){
                if(nums[col] < val){
                    dp[row] = Math.max(dp[row],dp[col]+1);
                }
            }
            max = Math.max(max,dp[row]);
        }
        return max;
    }
}
