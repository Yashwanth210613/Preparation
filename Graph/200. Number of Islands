class Solution {
    public int numIslands(char[][] grid) {
        int row = grid.length;
        int col = grid[0].length;
        int count=0;
        boolean[][] vis = new boolean[row][col];
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                if(!vis[i][j] && grid[i][j] == '1'){
                    dfs(grid,vis,i,j);
                    count++;
                }
            }
        }
        return count;
    }
    public void dfs(char[][] grid,boolean[][] vis,int row,int col){
        if(row < 0 || row >= grid.length || col < 0 || col >= grid[0].length || vis[row][col] || grid[row][col] == '0'){
            return;
        }
        vis[row][col] = true;
        dfs(grid,vis,row+1,col);
        dfs(grid,vis,row-1,col);
        dfs(grid,vis,row,col+1);
        dfs(grid,vis,row,col-1);
    }
}
