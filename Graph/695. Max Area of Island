class Solution {
    public int maxAreaOfIsland(int[][] grid) {
        int row = grid.length;
        int col = grid[0].length;
        int count = 0;
        int max = 0;
        boolean[][] vis = new boolean[row][col];
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                if(!vis[i][j] && grid[i][j] == 1){
                    count = dfs(grid,vis,i,j);
                    max = Math.max(max,count);
                }
            }
        }
        return max;
    }
    public int dfs(int[][] grid,boolean[][] vis,int row,int col){
        if(row < 0 || row >= grid.length || col < 0 || col >= grid[0].length || vis[row][col] || grid[row][col] == 0){
            return 0;
        }
        vis[row][col] = true;
        return 1 + dfs(grid,vis,row+1,col) + dfs(grid,vis,row-1,col) + dfs(grid,vis,row,col+1) + dfs(grid,vis,row,col-1);
    }
}
